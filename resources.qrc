  <qresource prefix="/icons">
    <file alias="app.svg">assets/app.svg</file>
    <file alias="mic.svg">assets/icons/mic.svg</file>
    <file alias="record.svg">assets/icons/record.svg</file>
    <file alias="stop.svg">assets/icons/stop.svg</file>
    <file alias="play.svg">assets/icons/play.svg</file>
    <file alias="pause.svg">assets/icons/pause.svg</file>
    <file alias="speaker.svg">assets/icons/speaker.svg</file>
    <file alias="settings.svg">assets/icons/settings.svg</file>
    <file alias="info.svg">assets/icons/info.svg</file>
    <file alias="volume.svg">assets/icons/volume.svg</file>
    <file alias="clear.svg">assets/icons/clear.svg</file>
    <file alias="check.svg">assets/icons/check.svg</file>
    <file alias="rewind.svg">assets/icons/rewind.svg</file>
    <file alias="forward.svg">assets/icons/forward.svg</file>
    <file alias="edit.svg">assets/icons/edit.svg</file>
    <file alias="folder.svg">assets/icons/folder.svg</file>
    <file alias="import.svg">assets/icons/import.svg</file>
    <file alias="export.svg">assets/icons/export.svg</file>
    <file alias="refresh.svg">assets/icons/refresh.svg</file>
    <file alias="back.svg">assets/icons/back.svg</file>
